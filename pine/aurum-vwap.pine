//@version=6
// =============================================================================
// AURUM VWAP — VWAP ancorato con bande, VWAP precedente e VWAP superiore
// KID Digital Wealth
//
//  · Ancoraggio: sessione, settimana, mese, trimestre, anno, data scelta,
//    swing high/low a N barre, oppure inizio del grafico.
//  · 3 coppie di bande (deviazione standard pesata per volume oppure %).
//  · VWAP del periodo precedente congelato come livello di riferimento.
//  · Secondo VWAP preso da un timeframe superiore (es. settimanale sul 1h).
//  · Tabella di stato (prezzo vs VWAP, distanza %, z-score) e alert.
//
// Nessun consiglio d'investimento. Uso didattico.
// =============================================================================
indicator("AURUM VWAP — ancorato con bande", shorttitle="AURUM VWAP", overlay=true, max_lines_count=100)

// ----------------------------------------------------------------------------
// INPUT
// ----------------------------------------------------------------------------
gA = "Ancoraggio"
anchorMode = input.string("Sessione", "Ancora il VWAP a",
     options=["Sessione", "Settimana", "Mese", "Trimestre", "Anno", "Data personalizzata", "Swing high (N barre)", "Swing low (N barre)", "Inizio grafico"], group=gA)
tAnchor = input.time(timestamp("01 Jan 2025 00:00 +0000"), "Data personalizzata", confirm=true, group=gA)
swLen   = input.int(50, "Lunghezza swing (barre)", minval=5, maxval=500, group=gA)
src     = input.source(hlc3, "Fonte di prezzo", group=gA)
useRth  = input.bool(false, "Solo orario di contrattazione regolare", tooltip="Esclude pre e after market: le barre fuori sessione non alimentano il VWAP.", group=gA)

gB = "Bande"
bandMode = input.string("Deviazione standard", "Tipo banda", options=["Deviazione standard", "Percentuale"], group=gB)
showB1 = input.bool(true,  "Banda 1", inline="b1", group=gB)
mult1  = input.float(1.0, "", minval=0.1, step=0.1, inline="b1", group=gB)
showB2 = input.bool(true,  "Banda 2", inline="b2", group=gB)
mult2  = input.float(2.0, "", minval=0.1, step=0.1, inline="b2", group=gB)
showB3 = input.bool(false, "Banda 3", inline="b3", group=gB)
mult3  = input.float(3.0, "", minval=0.1, step=0.1, inline="b3", group=gB)
fillB  = input.bool(true, "Riempimento tra le bande", group=gB)

gX = "Extra"
showPrev = input.bool(true, "VWAP del periodo precedente", group=gX)
showHtf  = input.bool(true, "VWAP da timeframe superiore", inline="h", group=gX)
htf      = input.timeframe("W", "", inline="h", group=gX)
colorBySide = input.bool(true, "Colora il VWAP in base alla posizione del prezzo", group=gX)
showTbl  = input.bool(true, "Tabella di stato", group=gX)
tblPos   = input.string("Alto destra", "Posizione tabella", options=["Alto destra","Alto sinistra","Basso destra","Basso sinistra"], group=gX)

cUp   = input.color(#23d18b, "Colore sopra VWAP", inline="c", group=gX)
cDn   = input.color(#ff4d5e, "Colore sotto VWAP", inline="c", group=gX)
cBand = input.color(#48a0ff, "Colore bande", group=gX)

// ----------------------------------------------------------------------------
// CONDIZIONE DI ANCORAGGIO
// ----------------------------------------------------------------------------
newHH = high > ta.highest(high, swLen)[1]
newLL = low  < ta.lowest(low, swLen)[1]

anchorCond = switch anchorMode
    "Sessione"            => timeframe.change("D")
    "Settimana"           => timeframe.change("W")
    "Mese"                => timeframe.change("M")
    "Trimestre"           => timeframe.change("3M")
    "Anno"                => timeframe.change("12M")
    "Data personalizzata" => time >= tAnchor and time[1] < tAnchor
    "Swing high (N barre)"=> newHH
    "Swing low (N barre)" => newLL
    => false

inSession = not useRth or not na(time(timeframe.period, session.regular))
started   = anchorMode == "Data personalizzata" ? time >= tAnchor : true

// ----------------------------------------------------------------------------
// CALCOLO VWAP E DEVIAZIONE PESATA PER VOLUME
// ----------------------------------------------------------------------------
var float sumPV  = 0.0
var float sumV   = 0.0
var float sumPV2 = 0.0
var float prevVwap = na
var float curVwap  = na

// volume assente (indici, alcuni forex) -> peso unitario: il VWAP degenera in media
w = nz(volume) > 0 ? volume : 1.0

if anchorCond
    prevVwap := curVwap
    sumPV  := 0.0
    sumV   := 0.0
    sumPV2 := 0.0

if started and inSession
    sumPV  := sumPV + src * w
    sumV   := sumV + w
    sumPV2 := sumPV2 + src * src * w

vwap = sumV > 0 ? sumPV / sumV : na
curVwap := vwap
variance = sumV > 0 ? math.max(sumPV2 / sumV - vwap * vwap, 0.0) : na
dev = math.sqrt(variance)

f_band(float m, bool upSide) =>
    offset = bandMode == "Percentuale" ? vwap * m / 100.0 : dev * m
    upSide ? vwap + offset : vwap - offset

up1 = f_band(mult1, true)
dn1 = f_band(mult1, false)
up2 = f_band(mult2, true)
dn2 = f_band(mult2, false)
up3 = f_band(mult3, true)
dn3 = f_band(mult3, false)

// ----------------------------------------------------------------------------
// VWAP DI TIMEFRAME SUPERIORE
// Calcolato sulle barre del grafico con reset al cambio di periodo superiore:
// nessuna richiesta HTF, quindi nessun repaint.
// ----------------------------------------------------------------------------
f_htfVwap() =>
    var float pv = 0.0
    var float vv = 0.0
    if timeframe.change(htf)
        pv := 0.0
        vv := 0.0
    wv = nz(volume) > 0 ? volume : 1.0
    pv := pv + hlc3 * wv
    vv := vv + wv
    vv > 0 ? pv / vv : na

htfVwap = f_htfVwap()

// ----------------------------------------------------------------------------
// PLOT
// ----------------------------------------------------------------------------
vwapCol = not colorBySide ? color.new(#e7b54a, 0) : close >= vwap ? color.new(cUp, 0) : color.new(cDn, 0)
pV = plot(vwap, "VWAP", color=vwapCol, linewidth=2)

pU1 = plot(showB1 ? up1 : na, "Banda +1", color=color.new(cBand, 35), linewidth=1)
pD1 = plot(showB1 ? dn1 : na, "Banda -1", color=color.new(cBand, 35), linewidth=1)
pU2 = plot(showB2 ? up2 : na, "Banda +2", color=color.new(cBand, 55), linewidth=1)
pD2 = plot(showB2 ? dn2 : na, "Banda -2", color=color.new(cBand, 55), linewidth=1)
pU3 = plot(showB3 ? up3 : na, "Banda +3", color=color.new(cBand, 70), linewidth=1)
pD3 = plot(showB3 ? dn3 : na, "Banda -3", color=color.new(cBand, 70), linewidth=1)

fill(pU1, pD1, color=fillB and showB1 ? color.new(cBand, 93) : na, title="Area banda 1")
fill(pU2, pU1, color=fillB and showB2 and showB1 ? color.new(cBand, 95) : na, title="Area banda 2 sup")
fill(pD1, pD2, color=fillB and showB2 and showB1 ? color.new(cBand, 95) : na, title="Area banda 2 inf")

plot(showPrev ? prevVwap : na, "VWAP precedente", color=color.new(#8294b4, 20), style=plot.style_stepline, linewidth=1)
plot(showHtf ? htfVwap : na, "VWAP " + htf, color=color.new(#9b7bff, 10), linewidth=2)

plotshape(anchorCond and not na(vwap), "Ancora", style=shape.xcross, location=location.belowbar, color=color.new(#e7b54a, 0), size=size.tiny)

// ----------------------------------------------------------------------------
// STATO: distanza e z-score
// ----------------------------------------------------------------------------
distPct = na(vwap) or vwap == 0 ? na : (close / vwap - 1) * 100
zScore  = na(dev) or dev == 0 ? na : (close - vwap) / dev
zone = na(zScore) ? "—" :
     zScore >= mult3 ? "oltre +" + str.tostring(mult3, "#.#") + "σ" :
     zScore >= mult2 ? "+" + str.tostring(mult2, "#.#") + "σ / +" + str.tostring(mult3, "#.#") + "σ" :
     zScore >= mult1 ? "+" + str.tostring(mult1, "#.#") + "σ / +" + str.tostring(mult2, "#.#") + "σ" :
     zScore > -mult1 ? "dentro ±" + str.tostring(mult1, "#.#") + "σ" :
     zScore > -mult2 ? "-" + str.tostring(mult1, "#.#") + "σ / -" + str.tostring(mult2, "#.#") + "σ" :
     zScore > -mult3 ? "-" + str.tostring(mult2, "#.#") + "σ / -" + str.tostring(mult3, "#.#") + "σ" :
     "oltre -" + str.tostring(mult3, "#.#") + "σ"

f_tblPos() =>
    switch tblPos
        "Alto destra"   => position.top_right
        "Alto sinistra" => position.top_left
        "Basso destra"  => position.bottom_right
        => position.bottom_left

var table tbl = table.new(f_tblPos(), 2, 6, border_width=1, frame_width=1, frame_color=color.new(#96aacd, 70))

f_cell(int r, string k, string v, color vc) =>
    table.cell(tbl, 0, r, k, text_color=color.new(#8294b4, 0), text_size=size.tiny, bgcolor=color.new(#0a111f, 10))
    table.cell(tbl, 1, r, v, text_color=vc, text_size=size.tiny, bgcolor=color.new(#0a111f, 10))

if showTbl and barstate.islast
    sideCol = close >= vwap ? color.new(cUp, 0) : color.new(cDn, 0)
    table.cell(tbl, 0, 0, "AURUM VWAP", text_color=color.new(#e7b54a, 0), text_size=size.tiny, bgcolor=color.new(#080d18, 0))
    table.cell(tbl, 1, 0, anchorMode, text_color=color.new(#cdd9ee, 0), text_size=size.tiny, bgcolor=color.new(#080d18, 0))
    f_cell(1, "VWAP", str.tostring(vwap, format.mintick), color.new(#cdd9ee, 0))
    f_cell(2, "Prezzo", close >= vwap ? "sopra VWAP" : "sotto VWAP", sideCol)
    f_cell(3, "Distanza", na(distPct) ? "—" : (distPct >= 0 ? "+" : "") + str.tostring(distPct, "#.##") + "%", sideCol)
    f_cell(4, "Z-score", na(zScore) ? "—" : str.tostring(zScore, "#.##") + "σ", sideCol)
    f_cell(5, "Zona", zone, color.new(#cdd9ee, 0))

// ----------------------------------------------------------------------------
// ALERT
// ----------------------------------------------------------------------------
crossUp   = ta.crossover(close, vwap)
crossDn   = ta.crossunder(close, vwap)
touchUp1  = showB1 and ta.crossover(high, up1)
touchDn1  = showB1 and ta.crossunder(low, dn1)
touchUp2  = showB2 and ta.crossover(high, up2)
touchDn2  = showB2 and ta.crossunder(low, dn2)

alertcondition(crossUp,  "Prezzo sopra VWAP", "AURUM VWAP: il prezzo ha incrociato il VWAP al rialzo")
alertcondition(crossDn,  "Prezzo sotto VWAP", "AURUM VWAP: il prezzo ha incrociato il VWAP al ribasso")
alertcondition(touchUp1, "Banda +1 raggiunta", "AURUM VWAP: raggiunta la banda superiore 1")
alertcondition(touchDn1, "Banda -1 raggiunta", "AURUM VWAP: raggiunta la banda inferiore 1")
alertcondition(touchUp2, "Banda +2 raggiunta", "AURUM VWAP: estensione sulla banda superiore 2")
alertcondition(touchDn2, "Banda -2 raggiunta", "AURUM VWAP: estensione sulla banda inferiore 2")

if (crossUp or crossDn) and barstate.isconfirmed
    alert("AURUM VWAP · " + syminfo.ticker + " " + timeframe.period + " · prezzo " + (crossUp ? "sopra" : "sotto") + " VWAP (" + str.tostring(vwap, format.mintick) + ")", alert.freq_once_per_bar_close)
